# nginx: sayt (kesh + bir xil sahifaga to'dan himoya), API va admin. Muhit: SITE_HOST, API_HOST, ADMIN_HOST, EDGE_REFRESH_TOKEN.
# TLS (HTTPS) bu yerda yo'q: uni oldingi qatlam (certbot/Cloudflare/yuk balansirovchi) beradi — docs/10-server.md.

# --- Siqish (gzip): HTML ~150 KB; siqilmasa ming-minglab qurilma (telefon, sekin tarmoq, umumiy kanal) uchun asosiy to'siq shu ---
# Sayt (sahifa va /_nuxt) uchun siqish HAR so'rovda emas, BIR marta qilinadi: ichki server (127.0.0.1:8081) siqadi, nginx keshi
# siqilgan nusxani saqlaydi va to'g'ridan-to'g'ri beradi (o'lchov: har so'rovda siqish 10 232 → 1 106 so'rov/s ga tushirgan edi).
# Quyidagi sozlama API va boshqa javoblar uchun ham amal qiladi.
gzip on;
gzip_comp_level 4;            # 4 — tezlik/siqish o'rtasi (yuqori daraja CPU'ni yeydi, foydasi kam)
gzip_min_length 1024;         # kichik javobni siqishdan foyda yo'q
gzip_proxied any;             # mobil operator/kompaniya proksilari ortidagi (Via sarlavhali) mijozlarga ham siqib beramiz
gzip_vary on;                 # `Vary: Accept-Encoding` — oraliq keshlar siqilgan/siqilmagan nusxani adashtirmasin
gzip_types text/plain text/css text/xml application/json application/javascript text/javascript application/xml application/rss+xml application/manifest+json image/svg+xml font/ttf font/otf application/vnd.ms-fontobject;
server_tokens off;            # nginx versiyasini sarlavhada ko'rsatmaymiz

proxy_cache_path /var/cache/nginx/site levels=1:2 keys_zone=site:50m max_size=1g inactive=10m use_temp_path=off;

# Backend admin saqlaganda shu sarlavha bilan sahifani so'raydi → nginx keshni chetlab o'tib YANGI nusxani saqlaydi.
# DIQQAT: kalit bo'sh bo'lsa hamma so'rov keshni chetlab o'tadi — compose kalit berilmasa ishga tushmaydi.
map $http_x_cache_refresh $cache_refresh {
  default 0;
  "${EDGE_REFRESH_TOKEN}" 1;
}

# Backenddagi to'g'ridan-to'g'ri so'rovlar uchun real IP: oldimizda yana bir proksi (Cloudflare/LB) bo'lsa, real_ip sozlang.
upstream nuxt    { server frontend:3000; keepalive 32; }
upstream backend { server backend:8000;  keepalive 32; }
upstream gz      { server 127.0.0.1:8081; keepalive 32; }   # quyidagi ichki siqish serveri

# --- Ichki siqish serveri: faqat nginx'ning o'zidan (127.0.0.1) so'raladi, tashqariga ochilmaydi ---
# Nuxtdan siqilmagan javob oladi va BIR marta siqadi; sayt serveri shuni keshlaydi. Yuqori daraja (6) — chunki keshga bir marta yoziladi.
server {
  listen 127.0.0.1:8081;
  gzip_comp_level 6;
  location / {
    proxy_pass http://nuxt;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $http_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header Accept-Encoding "";   # Nuxt siqmaydi; siqishni shu server o'zi qiladi
  }
}

# --- Sayt ---
server {
  listen 80 default_server;
  server_name ${SITE_HOST};

  location /_nuxt/ {                       # fayl nomida xesh bor — brauzerda bir yil, nginx keshida siqilgan holda
    proxy_pass http://gz;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Accept-Encoding gzip;  # keshda doim siqilgan nusxa; siqishni bilmaydigan mijozga `gunzip` ochib beradi
    gunzip on;
    proxy_ignore_headers Vary;              # kesh Vary bo'yicha bo'linib ketmasin (brauzerlarning Accept-Encoding qatori har xil); sarlavha mijozga baribir boradi
    proxy_cache site;
    proxy_cache_key $scheme$host$request_uri;
    proxy_cache_valid 200 7d;               # fayl nomi o'zgarsa yangi kalit — eskirish xavfi yo'q
    proxy_cache_lock on;
    expires 1y;
    add_header Cache-Control "public, immutable";
    add_header X-Cache $upstream_cache_status;
  }

  location = /api/_purge { return 404; }   # Nuxt keshini tozalash faqat ichki tarmoqdan (backend → frontend:3000), tashqaridan yo'q

  location / {
    proxy_pass http://gz;                  # ichki siqish serveri orqali (yuqorida)
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;   # ustiga yozamiz: soxta IP bilan so'rov cheklovini aylanib o'tib bo'lmasin
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Accept-Encoding gzip; # keshda doim SIQILGAN nusxa (bitta variant); har so'rovda qayta siqilmaydi
    gunzip on;                             # siqishni bilmaydigan kam uchraydigan mijozga nginx ochib beradi
    proxy_ignore_headers Vary;             # kesh Vary bo'yicha bo'linib ketmasin: har brauzer Accept-Encoding'ni boshqacha yozadi (gzip, deflate, br...) — aks holda har variant alohida MISS bo'lardi

    proxy_cache site;
    proxy_cache_key $scheme$host$request_uri;
    proxy_cache_valid 200 30s;             # Nuxt `Cache-Control: no-store/private` bergan sahifalar (kabinet, qidiruv) keshlanmaydi
    proxy_cache_lock on;                   # bir xil sahifaga ming so'rov — Node'ga bittasi boradi (single-flight)
    proxy_cache_lock_timeout 10s;
    proxy_cache_background_update on;       # eskirgan nusxa darrov beriladi, yangisi fonda olinadi (stale-while-revalidate)
    proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
    proxy_cache_bypass $cache_refresh;     # admin saqlaganda yangilash (yuqoridagi map)
    add_header X-Cache $upstream_cache_status;   # HIT / MISS / STALE / BYPASS — tekshirish uchun
  }
}

# --- API (backend) ---
server {
  listen 80;
  server_name ${API_HOST};
  client_max_body_size 25m;                # backenddagi BODY_LIMITS/UPLOAD_LIMITS bilan mos
  location / {
    proxy_pass http://backend;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;   # NUM_PROXIES=1 shunga tayanadi
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 40s;
  }
}

# --- Admin panel (statik) + /api → backend ---
server {
  listen 80;
  server_name ${ADMIN_HOST};
  root /usr/share/nginx/admin;
  client_max_body_size 25m;
  location /api/ {
    proxy_pass http://backend;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host ${API_HOST};
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
  location / { try_files $uri /index.html; }   # SPA marshrutlari
}
