# Nusxa oling: backend/.env (parol va kalitlarni o'zgartiring!)
DEBUG=true
SECRET_KEY=change-me-uzun-tasodifiy-satr
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Baza: .env.docker dagi foydalanuvchi va parol bilan bir xil
DATABASE_URL=postgres://uzswlu:bu-yerga-kuchli-parol@db:5432/uzswlu
PUBLIC_SERVER_URL=http://localhost:8000
# Cookie bilan so'rov yubora oladigan manzillar: Vue admin panel va sayt
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
ADMIN_PANEL_URL=http://localhost:5173
SITE_URL=http://localhost:3000
# Bo'sh bo'lsa token tekshirilmaydi; frontendda NUXT_API_TOKEN bilan bir xil bo'lsin
API_TOKEN=
SERVE_MEDIA=true
HIDE_UNTRANSLATED_POSTS=true
# Productionda: uzun tasodifiy qiymat (python -c "import secrets; print(secrets.token_urlsafe(32))"). Almashtirish: API_TOKEN=yangi,eski
# Swagger (/api/docs/) hamma uchun ochiqmi (productionda false — faqat admin panelga kirganlar)
API_DOCS_PUBLIC=true

# Birinchi ishga tushishda yaratiladigan superadmin
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-me-please

# HEMIS (universitet IT bo'limi beradi). Bo'sh bo'lsa — namuna ma'lumot ishlatiladi
HEMIS_API_URL=
HEMIS_API_TOKEN=
HEMIS_FACULTY_TYPES=11
HEMIS_CHAIR_TYPES=12
HEMIS_OAUTH_URL=
HEMIS_OAUTH_CLIENT_ID=
HEMIS_OAUTH_CLIENT_SECRET=

# Payload CMS'dan ko'chirish (bir marta): python manage.py import_payload --replace
PAYLOAD_DATABASE_URL=
PAYLOAD_MEDIA_URL=
# Admin panel JWT amal qilish muddati (soniya), sukut — 8 soat
JWT_TTL_SECONDS=28800
# Swagger sahifasi dizayni: modern (sukut: yumshoq ranglar, sarlavhada qo‘llanma) yoki classic
SWAGGER_THEME=modern

# --- Xavfsizlik va yuklama ---
# Backend oldida nechta proksi (nginx, Cloudflare…) bo'lsa shuncha. 0 bo'lsa X-Forwarded-For ishonchsiz deb hisoblanadi
# (so'rov cheklovi REMOTE_ADDR bo'yicha). Nginx orqasida — 1, Cloudflare + nginx — 2.
NUM_PROXIES=0
# So'rov cheklovlari (son/vaqt: sec, min, hour, day). Bo'sh qoldirsangiz — sukut qiymatlar
THROTTLE_LOGIN=10/min
THROTTLE_PUBLIC=300/min
THROTTLE_SEARCH=40/min
THROTTLE_APPEALS=20/hour
THROTTLE_HEMIS_AUTH=20/min
# Ochiq GET javoblari keshi (soniya, 0 — o'chirilgan). Admin panelda o'zgarish bo'lsa kesh darhol yangilanadi
PUBLIC_CACHE_SECONDS=60
# HEMIS nusxasini bazadan qayta o'qish oralig'i (soniya) va sinxronlashda sahifalar orasidagi pauza
HEMIS_CACHE_SECONDS=300
HEMIS_REQUEST_DELAY=0.2
HEMIS_OAUTH_TIMEOUT=8
# Admin ro'yxatida bir so'rovda ko'pi bilan nechta yozuv
ADMIN_MAX_LIMIT=5000
# Bir nechta server/jarayon bo'lsa umumiy kesh (so'rov cheklovi hisobi uchun); bo'sh bo'lsa fayl keshi
REDIS_URL=
# Gunicorn: jarayonlar, oqimlar va so'rov vaqti chegarasi
WEB_CONCURRENCY=3
WEB_THREADS=2
WEB_TIMEOUT=30

# Ikki bosqichli tasdiq (2FA, Google/Microsoft Authenticator) majburiy rollar, vergul bilan. Bo'sh — hamma uchun ixtiyoriy (Profil bo'limida yoqiladi)
REQUIRE_2FA_ROLES=

# Yopiq fayllar (fuqarolar murojaati ilovalari) — ochiq /media dan tashqarida. Serverda alohida volume.
# PRIVATE_ROOT=/app/private
