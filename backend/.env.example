# Nusxa oling: backend/.env (parollarni o'zgartiring!)
# Baza: .env.docker dagi foydalanuvchi va parol bilan bir xil
DATABASE_URL=postgres://uzswlu:bu-yerga-kuchli-parol@db:5432/uzswlu
# Uzun tasodifiy satr: openssl rand -hex 32
PAYLOAD_SECRET=bu-yerga-uzun-tasodifiy-satr

# Backend'ning tashqi manzili (rasm va fayl havolalari uchun)
PUBLIC_SERVER_URL=http://localhost:3001
# Cookie bilan so'rov yubora oladigan manzillar: admin panel va sayt
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# Birinchi ishga tushishda yaratiladigan superadmin (keyin parolni admin panelda almashtiring)
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=bu-yerga-kuchli-parol
SUPERADMIN_NAME=Superadmin
