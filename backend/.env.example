# Nusxa oling: backend/.env (parol va kalitlarni o'zgartiring!)
DEBUG=true
SECRET_KEY=change-me-uzun-tasodifiy-satr
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Baza: .env.docker dagi foydalanuvchi va parol bilan bir xil
DATABASE_URL=postgres://uzswlu:bu-yerga-kuchli-parol@db:5432/uzswlu
PUBLIC_SERVER_URL=http://localhost:8000
# Cookie bilan so'rov yubora oladigan manzillar: Vue admin panel va sayt
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
ADMIN_PANEL_URL=http://localhost:5173
SITE_URL=http://localhost:3000
# Bo'sh bo'lsa token tekshirilmaydi; frontendda NUXT_API_TOKEN bilan bir xil bo'lsin
API_TOKEN=
SERVE_MEDIA=true
HIDE_UNTRANSLATED_POSTS=true
# Swagger (/api/docs/) hamma uchun ochiqmi (productionda false — faqat admin panelga kirganlar)
API_DOCS_PUBLIC=true

# Birinchi ishga tushishda yaratiladigan superadmin
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-me-please

# HEMIS (universitet IT bo'limi beradi). Bo'sh bo'lsa — namuna ma'lumot ishlatiladi
HEMIS_API_URL=
HEMIS_API_TOKEN=
HEMIS_FACULTY_TYPES=11
HEMIS_CHAIR_TYPES=12
HEMIS_OAUTH_URL=
HEMIS_OAUTH_CLIENT_ID=
HEMIS_OAUTH_CLIENT_SECRET=

# Payload CMS'dan ko'chirish (bir marta): python manage.py import_payload --replace
PAYLOAD_DATABASE_URL=
PAYLOAD_MEDIA_URL=
# Admin panel JWT amal qilish muddati (soniya), sukut — 8 soat
JWT_TTL_SECONDS=28800
# Swagger sahifasi dizayni: classic (sukut) yoki creative (gradient sarlavha, tezkor boshlash kartalari)
SWAGGER_THEME=classic
